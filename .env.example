SECRET_KEY=evalai-insecure-django-dev-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL/pgvector (Docker uses these values)
DB_ENGINE=sqlite
POSTGRES_DB=eadaes
POSTGRES_USER=eadaes
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_VISION_BATCH_SIZE=3
GROQ_VISION_MAX_TOKENS=3500

# Provider-neutral LLM layer
LLM_PROVIDER=groq
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
LLM_PROMPT_VERSION=eadaes-v1
LLM_CONFIDENCE_THRESHOLD=0.65

# Celery / Redis
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500
